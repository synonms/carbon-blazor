@implements IDisposable

<div class="cb-shell-layout @CarbonBlazorThemeMapper.ToCssClass(Theme) @(LeftPanelContent is null ? "header-only" : "has-left-panel") @(!_coordinator.IsNavigationExpanded ? "sidebar-collapsed" : string.Empty)"
     @onclick="DismissOverlays"
     @onkeydown="OnKeyDown">
    <a class="cb-shell-skip-link" href="#@_mainId">Skip to main content</a>
    <CascadingValue Value="@_coordinator">
        @HeaderContent
        @LeftPanelContent
        <main id="@_mainId" class="cb-shell-main" tabindex="-1">
            @ChildContent
        </main>
    </CascadingValue>
    <CarbonBlazorNotificationToastQueue></CarbonBlazorNotificationToastQueue>
</div>

@code {
    private static int _instanceCount;
    private readonly string _mainId = $"cb-shell-main-{Interlocked.Increment(ref _instanceCount)}";
    private readonly CarbonBlazorShellCoordinator _coordinator = new();

    [Parameter]
    public RenderFragment? HeaderContent { get; set; }

    [Parameter]
    public RenderFragment? LeftPanelContent { get; set; }

    [Parameter]
    [EditorRequired]
    public RenderFragment ChildContent { get; set; } = null!;

    [Parameter]
    public CarbonBlazorTheme Theme { get; set; } = CarbonBlazorTheme.White;

    [Parameter]
    public EventCallback<CarbonBlazorTheme> ThemeChanged { get; set; }

    protected override void OnParametersSet()
    {
        bool themeChanged = _coordinator.Theme != Theme;
        _coordinator.NavigationId = $"cb-shell-left-panel-{_mainId}";
        _coordinator.Theme = Theme;
        _coordinator.ThemeChanged = ThemeChanged;
        _coordinator.HasLeftPanel = LeftPanelContent is not null;
        if (themeChanged)
        {
            _coordinator.NotifyThemeUpdated();
        }
    }

    protected override void OnInitialized()
    {
        _coordinator.NavigationChanged += OnNavigationChanged;
        _coordinator.ThemeUpdated += OnThemeUpdated;
    }

    private void OnNavigationChanged() => _ = InvokeAsync(StateHasChanged);

    private void OnThemeUpdated() => _ = InvokeAsync(StateHasChanged);

    private async Task DismissOverlays()
    {
        await _coordinator.CloseRightPanels();
        if (_coordinator.CloseMobileNavigation is not null)
        {
            await _coordinator.CloseMobileNavigation.Invoke();
        }
    }

    private async Task OnKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Escape")
        {
            bool restoreNavigationFocus = _coordinator.IsMobileNavigationOpen;
            await _coordinator.CloseRightPanels();
            if (_coordinator.CloseMobileNavigation is not null)
            {
                await _coordinator.CloseMobileNavigation.Invoke();
            }
            if (restoreNavigationFocus && _coordinator.RestoreNavigationFocus is not null)
            {
                await _coordinator.RestoreNavigationFocus.Invoke();
            }
        }
    }

    public void Dispose()
    {
        _coordinator.NavigationChanged -= OnNavigationChanged;
        _coordinator.ThemeUpdated -= OnThemeUpdated;
    }
}
