<CarbonBlazorShellLeftPanel IsExpanded="@IsExpanded" IsExpandedChanged="@IsExpandedChanged" ThemeOverride="@ThemeOverride">
    @ChildContent
</CarbonBlazorShellLeftPanel>

@code {
    [Parameter]
    public RenderFragment ChildContent { get; set; } = null!;

    [Parameter]
    public CarbonBlazorTheme? ThemeOverride { get; set; }

    [Parameter]
    public bool IsExpanded { get; set; } = true;

    [Parameter]
    public EventCallback<bool> IsExpandedChanged { get; set; }
}
