@using Microsoft.AspNetCore.Components.Routing

<li class="cb-sidebar-submenu">
    <button type="button" class="cb-sidebar-submenu-toggle" aria-expanded="@_isExpanded.ToString().ToLowerInvariant()"
            aria-controls="@_submenuId" @onclick="Toggle">
        @if (Icon is not null)
        {
            <CarbonBlazorIcon Type="@(Icon.Value)"></CarbonBlazorIcon>
        }
        <span>@Text</span>
        <CarbonBlazorIcon Type="@(_isExpanded ? CarbonBlazorIconType.ChevronUp : CarbonBlazorIconType.ChevronDown)"></CarbonBlazorIcon>
    </button>
    <ul id="@_submenuId" class="cb-sidebar-submenu-items" hidden="@(!_isExpanded)">
        @foreach (NavigationItem item in SubMenuItems)
        {
            <li class="cb-sidebar-submenu-item">
                <NavLink href="@item.Href" Match="NavLinkMatch.All" @onclick="CloseNavigationAction">@item.Text</NavLink>
            </li>
        }
    </ul>
</li>

@code {
    private static int _instanceCount;
    private readonly string _submenuId = $"cb-sidebar-submenu-{Interlocked.Increment(ref _instanceCount)}";
    private bool _isExpanded;

    [CascadingParameter]
    private Func<Task>? CloseNavigation { get; set; }

    [Parameter]
    public CarbonBlazorIconType? Icon { get; set; }

    [Parameter, EditorRequired]
    public string Text { get; set; } = string.Empty;

    [Parameter, EditorRequired]
    public IEnumerable<NavigationItem> SubMenuItems { get; set; } = [];

    private void Toggle()
    {
        _isExpanded = !_isExpanded;
    }

    private Task CloseNavigationAction() => CloseNavigation?.Invoke() ?? Task.CompletedTask;
}
