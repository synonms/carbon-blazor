@typeparam TValue

<CarbonBlazorFieldSet IsDoubleColumn="@IsDoubleColumn" IsReadOnly="@IsReadOnly" IsDisabled="@IsDisabled">
    @if (string.IsNullOrWhiteSpace(Label) is false)
    {
        <label for="@Id" class="cb-date-time-picker-label">@Label</label>
    }

    <div class="cb-date-time-picker-wrapper">
        @{
            string dateId = Id + "_Date";
            string timeId = Id + "_Time";
            <CarbonBlazorDatePicker TValue="DateOnly?" Id="@dateId" Size="@Size" Layer="@Layer" IsDisabled="@IsDisabled" IsReadOnly="@IsReadOnly" IsDoubleColumn="true" Value="@_date" ValueChanged="@OnDateChanged" FieldIdentifier="@FieldIdentifier"></CarbonBlazorDatePicker>
            <CarbonBlazorTimePicker TValue="TimeOnly?" Id="@timeId" Size="@Size" Layer="@Layer" IsDisabled="@IsDisabled" IsReadOnly="@IsReadOnly" IsDoubleColumn="true" Value="@_time" ValueChanged="@OnTimeChanged" FieldIdentifier="@FieldIdentifier"></CarbonBlazorTimePicker>
        }
    </div>

    <CarbonBlazorValidationMessage FieldIdentifier="@FieldIdentifier"></CarbonBlazorValidationMessage>

    @if (string.IsNullOrWhiteSpace(HelperText) is false)
    {
        <div id="@Id-helper-text" class="cb-date-time-picker-helper">@HelperText</div>
    }
</CarbonBlazorFieldSet>

@code {
    private DateOnly? _date;
    private TimeOnly? _time;

    [CascadingParameter]
    public EditContext? EditContext { get; set; }
    
    [CascadingParameter]
    public IEnumerable<ValidationOutcome> ValidationOutcomes { get; set; } = [];

    [Parameter]
    [EditorRequired]
    public FieldIdentifier FieldIdentifier { get; set; }
    
    [Parameter]
    [EditorRequired]
    public TValue Value { get; set; } = default!;
    
    [Parameter]
    public EventCallback<TValue> ValueChanged { get; set; }

    [Parameter]
    public string? Id { get; set; }
    
    [Parameter]
    public CarbonBlazorInputSize Size { get; set; } = CarbonBlazorInputSize.Medium;

    [Parameter]
    public CarbonBlazorLayer Layer { get; set; } = CarbonBlazorLayer.Two;

    [Parameter]
    public string? Label { get; set; }

    [Parameter]
    public string? HelperText { get; set; }
    
    [Parameter]
    public bool IsDisabled { get; set; }

    [Parameter]
    public bool IsReadOnly { get; set; }
    
    [Parameter]
    public bool IsDoubleColumn { get; set; }

    protected override void OnParametersSet()
    {
        base.OnParametersSet();
        
        DateTime? dateTimeValue = GetDateTimeValue();

        _date = dateTimeValue is null || DateOnly.FromDateTime(dateTimeValue.Value) == DateOnly.MinValue
            ? null
            : DateOnly.FromDateTime(dateTimeValue.Value);
        _time = dateTimeValue is null ? null : TimeOnly.FromDateTime(dateTimeValue.Value);
    }

    private async Task OnDateChanged(DateOnly? date)
    {
        _date = date;
        
        await ValueUpdated();
    }

    private async Task OnTimeChanged(TimeOnly? time)
    {
        _time = time;

        await ValueUpdated();
    }
    
    private async Task ValueUpdated()
    {
        DateTime? updatedValue;

        if (_date is not null)
        {
            if (_time is not null)
            {
                updatedValue = _date.Value.ToDateTime(_time.Value);
            }
            else
            {
                updatedValue = _date.Value.ToDateTime(TimeOnly.MinValue);
            }
        }
        else
        {
            if (_time is not null)
            {
                updatedValue = DateOnly.MinValue.ToDateTime(_time.Value);
            }
            else
            {
                updatedValue = null;
            }
        }

        Value = ConvertToValue(updatedValue);

        await ValueChanged.InvokeAsync(Value);

        EditContext?.NotifyFieldChanged(FieldIdentifier);
    }

    private DateTime? GetDateTimeValue()
    {
        EnsureSupportedValueType();

        object? value = Value;

        if (value is null)
        {
            return null;
        }

        return (DateTime)value;
    }

    private TValue ConvertToValue(DateTime? value)
    {
        EnsureSupportedValueType();

        if (value is null)
        {
            if (IsNullableValue())
            {
                return default!;
            }

            return (TValue)(object)default(DateTime);
        }

        return (TValue)(object)value.Value;
    }

    private static void EnsureSupportedValueType()
    {
        Type valueType = Nullable.GetUnderlyingType(typeof(TValue)) ?? typeof(TValue);

        if (valueType != typeof(DateTime))
        {
            throw new InvalidOperationException($"{nameof(CarbonBlazorDateTimePicker<TValue>)} only supports DateTime and DateTime? values.");
        }
    }

    private static bool IsNullableValue()
    {
        return Nullable.GetUnderlyingType(typeof(TValue)) is not null;
    }
}