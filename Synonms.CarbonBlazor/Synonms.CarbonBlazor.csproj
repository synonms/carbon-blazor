<Project Sdk="Microsoft.NET.Sdk.Razor">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>true</IsPackable>
        <Title>Synonms Carbon Blazor</Title>
        <Authors>Synonms</Authors>
        <!-- Fallback for local development builds -->
        <!-- CI overrides this via -p:PackageVersion at pack time -->
        <VersionPrefix>10.0.0</VersionPrefix>        
        <Description>CarbonBlazor is a simple, opinionated implementation of IBM's Carbon Design System for Blazor.</Description>
        <Copyright>2025 Synonms</Copyright>
        <RepositoryUrl>https://github.com/synonms/carbon-blazor</RepositoryUrl>
        <RepositoryType>GitHub</RepositoryType>
        <PackageTags>Blazor;IBM;Carbon;Design;UI;UX;Components;</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <SupportedPlatform Include="browser"/>
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.12" />
      <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.12" />
      <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Authentication" Version="10.0.12" />
    </ItemGroup>

</Project>
