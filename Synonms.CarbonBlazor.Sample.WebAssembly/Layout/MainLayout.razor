@inherits LayoutComponentBase

<PageTitle>Synonms CarbonBlazor</PageTitle>

<CarbonBlazorShell @bind-Theme="_theme">
    <HeaderContent>
        <CarbonBlazorShellHeader ProductName="CarbonBlazor" HomeHref="/" ThemeOverride="CarbonBlazorTheme.Gray100" EnableThemeSwitcher="true">
            <AccountPanel>
                <CarbonBlazorHeaderActionLink NavigationItem="@NavigationItem.Create("Login", "/")" />
            </AccountPanel>
        </CarbonBlazorShellHeader>
    </HeaderContent>
    <LeftPanelContent>
        <CarbonBlazorShellLeftPanel ThemeOverride="CarbonBlazorTheme.White">
            <CarbonBlazorSidebarLink NavigationItem="@NavigationItem.Create(CarbonBlazorIconType.Dashboard, "Dashboard", "/")" />
            <CarbonBlazorSidebarLink NavigationItem="@NavigationItem.Create(CarbonBlazorIconType.Apps, "Storybook", "/storybook")" />
            <CarbonBlazorSidebarSubMenu Text="Menu Group" SubMenuItems="@_subMenuItems" />
        </CarbonBlazorShellLeftPanel>
    </LeftPanelContent>
    <ChildContent>@Body</ChildContent>
</CarbonBlazorShell>

@code {
    private CarbonBlazorTheme _theme = CarbonBlazorTheme.White;

    private readonly List<NavigationItem> _subMenuItems =
    [
        new NavigationItem("Sub-Menu Item 1", "/"),
        new NavigationItem("Sub-Menu Item 2", "/"),
        new NavigationItem("Sub-Menu Item 3", "/")
    ];
}